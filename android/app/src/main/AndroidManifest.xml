<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 푸시 알림 표시 (Android 13+ 런타임 권한) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WebView CSV 등 다운로드(DownloadManager) — Android 9 이하에서만 필요 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 백업 규칙: 로그인 토큰 파일(rox_tokens.xml)은 백업·기기 이전에서 제외 — res/xml 두 파일 주석 참조.
         fullBackupContent 는 API 30 이하, dataExtractionRules 는 API 31+ 에 적용된다(감사 R05). -->
    <application
        android:name=".RoxApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roxlogy"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Roxlogy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 수신 서비스 (google-services.json 있을 때만 실제 동작) -->
        <service
            android:name=".push.RoxMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 기본 알림 채널·아이콘 (백그라운드 notification 메시지를 시스템 트레이가 표시할 때 사용) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="rox_push" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_rox" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/rox_notif_accent" />

        <!-- 워치 → 폰 세션 수신 (Data Layer) -->
        <service
            android:name=".sync.PhoneDataReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/roxlogy/session/" />
            </intent-filter>
        </service>
    </application>
</manifest>
