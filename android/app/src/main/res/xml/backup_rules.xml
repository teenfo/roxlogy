<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup 규칙 (Android 11 / API 30 이하 — Manifest android:fullBackupContent).
  API 31+ 는 data_extraction_rules.xml 이 대신 적용된다. 두 파일의 제외 목록은 같아야 한다.

  왜 rox_tokens.xml 을 제외하나: 로그인 토큰은 EncryptedSharedPreferences(TokenStore.PREFS_NAME)에
  저장되고, 그 마스터키는 Android Keystore 에 있어 백업되지 않는다. 파일만 다른 기기·재설치 환경으로
  복원되면 복호화가 불가능해 쓸모가 없고(재로그인 필요), 자격증명은 원래 백업 대상이 아니다(감사 R05).
  참고: https://developer.android.com/identity/data/autobackup#include-exclude-android-11
-->
<full-backup-content>
    <exclude
        domain="sharedpref"
        path="rox_tokens.xml" />
</full-backup-content>
