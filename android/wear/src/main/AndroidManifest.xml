<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- PM5 BLE 수집 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 이하 BLE 스캔용 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Health Services 트레드밀 러닝 거리(걸음/가속도 기반) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 랩 기록·목표 이탈 햅틱 피드백 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 세그먼트별 심박 기록 (Health Services HEART_RATE_BPM) -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 시뮬 진행 중 포그라운드 서비스 + Ongoing Activity (화면 꺼짐에도 세션 유지) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ongoing Activity 는 헬스 타입 FGS 로 선언 (BODY_SENSORS 권한 보유) -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roxlogy">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Roxlogy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 시뮬 진행 중 유지 + Ongoing Activity 표시 -->
        <service
            android:name=".service.SimSessionService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>
</manifest>
