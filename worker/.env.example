# hosub 분석 워커 — 시크릿은 hosub 서버 내부에서만 주입 (커밋 금지)
SUPABASE_URL=https://vuloxbpfhyqkvgmpmkst.supabase.co
# service role 키는 서버/워커 내부 시크릿으로만. 클라이언트에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 선택 튜닝
WORKER_POLL_INTERVAL_S=10
WORKER_BATCH=5
WORKER_STALE_PROCESSING_S=300

# ---- AI 인사이트 (hosub → Mac Ollama 브릿지) ----
# Mac(같은 LAN)의 Ollama 주소. Mac 이 꺼져 있으면 LLM 작업만 보류되고 지표 계산은 계속.
# Mac 쪽은 OLLAMA_HOST=0.0.0.0 로 LAN 바인딩 필요 (docs/AI_WORKER_SETUP.md).
OLLAMA_URL=http://192.168.0.10:11434
OLLAMA_MODEL=qwen2.5:32b
AI_ENABLED=1
AI_BATCH=3
