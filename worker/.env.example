# hosub 분석 워커 — 시크릿은 hosub 서버 내부에서만 주입 (커밋 금지)
SUPABASE_URL=https://vuloxbpfhyqkvgmpmkst.supabase.co
# service role 키는 서버/워커 내부 시크릿으로만. 클라이언트에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# 선택 튜닝
WORKER_POLL_INTERVAL_S=10
WORKER_BATCH=5
WORKER_STALE_PROCESSING_S=300

# ---- AI 인사이트 (hosub llm-gateway 경유, Mac Ollama 백엔드) ----
# 게이트웨이: /opt/hosub-mcp/llm-gateway (같은 hosub 위 — localhost 사용).
# 토큰은 게이트웨이 .env 의 LLMGW_TOKEN_ROXLOGY 와 동일 값 (커밋 금지).
# 게이트웨이/Mac 이 죽어 있으면 LLM 작업만 보류되고 지표 계산은 계속.
LLMGW_URL=http://127.0.0.1:8603
LLMGW_TOKEN=
# 역할(roles.yaml): coach_feedback=qwen2.5:32b(고품질) / analyze_workout=14b(빠름)
AI_ROLE=coach_feedback
AI_ENABLED=1
AI_BATCH=3
