# Supabase (프로젝트 대시보드 > Settings > API 에서 복사)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 구글 원탭 (선택) — Supabase Auth 에 등록한 것과 같은 OAuth "웹 클라이언트" ID.
# 공개 식별자라 클라이언트에 노출돼도 된다. 비워 두면 원탭이 아예 뜨지 않고
# 기존 구글 로그인 버튼만 동작한다.
# 구글 클라우드 콘솔에서 "승인된 JavaScript 원본" 에 https://roxlogy.com 을
# 반드시 추가해야 한다(원탭은 리디렉트가 아니라 origin 을 검사한다).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 서버/워커 전용 — 절대 클라이언트에 노출 금지, 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
